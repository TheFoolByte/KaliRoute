# ==============================================================================
# KaliRoute — Variabel Railway (format .env)
# ------------------------------------------------------------------------------
# Cara pakai: Railway -> service -> Variables -> Raw Editor, lalu tempel isi file
# ini dan GANTI semua nilai contoh dengan nilai asli kamu.
#
# 2 tempat konfigurasi:
#   1. Railway Variables (file ini)          -> kredensial & repo backup
#   2. /etc/kaliroute/config.json            -> di-bake dari config.example.json,
#                                               isinya root_password + setelan 9Router
#   Prioritas: Railway Variables MENANG atas config.json untuk root_password & repo.
#
# JANGAN commit nilai asli ke Git. File ini contoh/template saja.
# ==============================================================================


# ==============================================================================
# 1. WAJIB — service tidak mau start tanpa ini
# ==============================================================================

# Password root. Dipakai di 3 tempat: login SSH, basic auth ttyd, dan
# INITIAL_PASSWORD 9Router. Kalau kosong, entrypoint langsung exit (fail-closed).
ROOT_PASSWORD=GANTI_dengan_password_root_yang_kuat_dan_panjang


# ==============================================================================
# 2. OPSIONAL — tapi sangat disarankan
# ==============================================================================

# Isi /root/.ssh/authorized_keys. Bisa banyak key dipisah baris baru.
# Di Raw Editor Railway, nilai multi-baris didukung (tempel apa adanya).
AUTHORIZED_KEYS=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyOnlyReplaceThis you@laptop

# Token untuk restore + auto-backup. Butuh akses Contents: Read & Write
# ke 2 repo backup (private). Kalau kosong, fitur backup mati (service tetap jalan).
GITHUB_TOKEN=github_pat_11AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Repo backup untuk /root/.9router. Format: owner/repo
APPS_REPO=namamu/kaliroute-apps

# Repo backup untuk /root/tools, /root/wordlists, /root/labs, dan dotfiles
# (.zshrc, .bashrc, .vimrc, .tmux.conf). Format: owner/repo
KALI_REPO=namamu/kaliroute-kali

# Detik antar auto-backup. Default 300.
SYNC_INTERVAL=300

# Port ttyd. HARUS sama dengan target port domain Railway-mu. Default 7681.
TTYD_PORT=7681

# Username untuk login ttyd. Default root.
USERNAME=root


# ==============================================================================
# 3. ADVANCED — jarang dipakai, untuk testing lokal
# ==============================================================================

# CONFIG_FILE=/etc/kaliroute/config.json
# KR_ROOT=/root
# KR_STAGE=/root/src-apps
# KR_REMOTE_URL=
# KR_CLEAN_REMOTE_URL=
# GITHUB_SYNC_NAME="KaliRoute Sync"
# GITHUB_SYNC_EMAIL=kaliroute-sync@local


# ==============================================================================
# CATATAN: VOLUME & ROUTING PORT (di-set manual di Railway, bukan di file ini)
# ==============================================================================
#
# VOLUME (WAJIB): attach volume dengan mount path /root. Ini satu-satunya
#   persistensi. Tanpa volume, .9router, tools/, wordlists/, labs/ hilang tiap
#   redeploy/restart dan backup GitHub kehilangan sumbernya.
#
# PORT:
#   - TTYD_PORT (7681)  -> ttyd. Set target port domain publik ke 7681.
#                          ttyd TIDAK memakai PORT bawaan Railway.
#   - 22                -> SSH. Buat TCP Proxy dengan target port 22.
#   - 20128             -> 9Router. JANGAN di-expose publik; pakai SSH tunnel.
#   - PORT (Railway)    -> tidak dipakai. Entrypoint sengaja `env -u PORT`
#                          supaya 9Router memakai port-nya sendiri.
#
#   SSH:          ssh -p <PORT_TCP_PROXY> root@<HOST_TCP_PROXY>
#   Tunnel 9Router: ssh -p <PORT> -L 20128:127.0.0.1:20128 root@<HOST>
#                    lalu buka http://127.0.0.1:20128


# ==============================================================================
# CATATAN: KEAMANAN (penting)
# ==============================================================================
#
# - Satu password untuk 3 pintu (SSH + ttyd + 9Router). Kalau bocor, ketiganya
#   kena. Pakai password panjang & acak, simpan hanya di Railway Variables.
#
# - 9Router punya logika "hash lama menang". Kalau di volume /root/.9router
#   sudah pernah ada password 9Router, maka INITIAL_PASSWORD TIDAK menimpanya.
#   Jadi kalau ROOT_PASSWORD diganti, password 9Router TIDAK ikut berubah —
#   ganti manual di setting 9Router.
#
# - SSH: password auth selalu aktif. Dockerfile menulis
#   `PasswordAuthentication yes` + `PermitRootLogin yes` dan tidak dimatikan
#   walau AUTHORIZED_KEYS diisi. Setelah login pakai key berhasil, matikan:
#       sed -i 's/^PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config
#       pkill -HUP sshd
#
# - ttyd = basic auth (1 faktor). Terenkripsi oleh TLS Railway, tapi tetap
#   jangan biarkan domain ttyd terbuka tanpa password.
#
# - Jangan expose 9Router. API key-nya bukan bukti halaman admin terlindungi.
#
# - Token GitHub: pakai PAT dengan scope seminimal mungkin (2 repo backup itu
#   saja, Contents: Read & Write).


# ==============================================================================
# CHECKLIST DEPLOY DI AKUN RAILWAY BARU
# ==============================================================================
#
# 1. Bikin 2 repo GitHub PRIVATE: satu untuk APPS_REPO, satu untuk KALI_REPO.
# 2. Bikin PAT GitHub (Contents: Read & Write untuk 2 repo itu).
# 3. Deploy project KaliRoute ke service Railway baru (builder: Dockerfile).
# 4. Attach volume dengan mount path /root.
# 5. Isi Variables (file ini, ganti nilainya).
# 6. Set target port domain ke 7681 (ttyd), dan TCP Proxy -> 22 (SSH).
# 7. Deploy. Di log akan terlihat restore app-sync lalu kali-sync sebelum service nyala.
# 8. Masuk lewat ttyd/SSH, cek 9Router + wordlist sudah kembali.
# 9. Pastikan auto-backup jalan: tail -f /var/log/app-sync.log /var/log/kali-sync.log


# ==============================================================================
# VERIFIKASI CEPAT (dari dalam container)
# ==============================================================================
#
#   app-sync status ; kali-sync status      # status backup terakhir
#   app-sync backup ; kali-sync backup      # backup manual tanpa nunggu interval
#   ss -lntp | grep -E '20128|7681|:22'     # cek service listen
#   tail -n 50 /var/log/9router.log
#   tail -n 50 /var/log/app-sync.log
#   tail -n 50 /var/log/kali-sync.log


# ==============================================================================
# QUIRK DI KODE (biar tidak bingung)
# ==============================================================================
#
# - github_sync_name / github_sync_email di config.json TIDAK berfungsi.
#   Entrypoint tidak pernah mengekspornya, jadi script selalu memakai default.
#   Kalau mau author commit custom, set GITHUB_SYNC_NAME / GITHUB_SYNC_EMAIL
#   sebagai Railway Variables.
#
# - config.json bukan pengganti Variables. Kredensial pakai Railway Variables;
#   config.json hanya untuk setelan 9Router.
#
# - Restore berjalan SEBELUM service. Kalau repo backup masih kosong, log akan
#   bilang "remote has no main branch yet — nothing to restore". Itu normal.
#
# - `git pull --rebase --autostash` dipakai sebelum push. Kalau dua instance
#   backup ke repo yang sama bersamaan, bisa konflik. Pakai 1 service per
#   pasangan repo.
